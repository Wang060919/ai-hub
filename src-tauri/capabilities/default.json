{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the AI Hub main window without file, shell, or tray access.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "core:resources:default",
    "core:webview:default",
    "core:window:default",
    "allow-fetch-backend-metadata",
    "allow-send-chat-message",
    "allow-preview-file",
    "allow-summarize-file",
    "allow-fetch-knowledge-status",
    "allow-index-knowledge-file",
    "allow-index-knowledge-markdown-directory",
    "allow-search-knowledge",
    "allow-query-knowledge"
  ]
}
